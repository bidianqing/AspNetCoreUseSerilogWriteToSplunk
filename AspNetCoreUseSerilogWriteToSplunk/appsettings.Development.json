{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Splunk" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "EventCollector",
        "Args": {
          "splunkHost": "https://df7df5cd1ef081d4-1-8088.papa.r.killercoda.com/",
          "uriPath": "services/collector/event",
          "eventCollectorToken": "8d42586e-0eb5-4366-a743-807c7166b30a",
          "index": "app_log",
          "batchIntervalInSeconds": 5
        }
      }
    ],
    "Properties": {
      "Application": "Serilog Splunk Console Sample"
    }
  }
}
