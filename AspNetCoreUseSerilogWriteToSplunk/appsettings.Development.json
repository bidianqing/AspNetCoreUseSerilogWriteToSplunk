{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Splunk" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "EventCollector",
        "Args": {
          "splunkHost": "https://20670791bbbe3c83-1-8088.papa.r.killercoda.com",
          "uriPath": "services/collector/event",
          "eventCollectorToken": "732f855d-be26-4fc2-b7e3-3754b069af40",
          "index": "app_log",
          "batchIntervalInSeconds": 5
        }
      }
    ],
    "Properties": {
      "Application": "Serilog Splunk Console Sample"
    }
  }
}
